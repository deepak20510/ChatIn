{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://chatin-uqkb.onrender.com/api/$1" },
    { "source": "/socket.io/(.*)", "destination": "https://chatin-uqkb.onrender.com/socket.io/$1" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|mp3|wav|ogg))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
