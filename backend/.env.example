# ============================================================
# ChatIn Backend - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit your real .env file to version control!
# ============================================================

# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production       # Use "development" locally

# ─── Frontend URL (CORS & cookie configuration) ────────────
# Set to your Vercel/production URL in production
# e.g. https://chatin.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app

# ─── MongoDB ───────────────────────────────────────────────
# MongoDB Atlas connection string (recommended for production)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://youruser:yourpassword@cluster0.mongodb.net/chatin?retryWrites=true&w=majority

# ─── JWT Secret ────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Must be set in production or the server will refuse to start!
JWT_SECRET=your_very_long_and_random_secret_key_here_at_least_32_chars

# ─── Cloudinary (Image Storage) ────────────────────────────
# Required for profile pictures and image messages
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Resend (Email Service) ────────────────────────────────
# Optional — used for welcome emails on signup
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=ChatIn

# ─── Arcjet (Bot & DDoS Protection) ───────────────────────
# Optional — provides advanced bot detection and shield protection
# Get from: https://app.arcjet.com
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxx
ARCJET_ENV=production    # Use "development" locally
